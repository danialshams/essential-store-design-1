# Set only in Vercel server environments; never NEXT_PUBLIC_ for the shared secret.
# If unset or unavailable, all existing demo products and demo checkout remain intact.
STOREFRONT_ADMIN_ORIGIN=
STOREFRONT_API_SECRET=

# Independent Essential 01 Postgres database (server only)
DATABASE_URL=
STORE_ADMIN_LOCAL=1
# Public writable admin: ONLY for the prototype, disable before real customers or payments.
TEMP_PUBLIC_ADMIN_EDIT=1
NEXT_PUBLIC_STUDIO_DEMO=0
# Optional S3-compatible storage for uploading new images.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
